<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.healthai.imessage-group-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/REPLACE/WITH/ABS/PATH/tools/imessage-group-bot/bot.py</string>
        <string>--config</string>
        <string>/REPLACE/WITH/ABS/PATH/tools/imessage-group-bot/config.json</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/REPLACE/WITH/ABS/PATH/tools/imessage-group-bot</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/REPLACE/WITH/ABS/PATH/tools/imessage-group-bot/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/REPLACE/WITH/ABS/PATH/tools/imessage-group-bot/data/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>

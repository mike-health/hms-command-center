# Linear personal or workspace API key (Settings → API).
# Used only on the server; never expose to the browser.
LINEAR_API_KEY=

# Viewer passcode for the Pleasant Hill page and /api/pleasant-hill.
# Required before LINEAR_API_KEY is set: if the key is present and this
# is missing, live Linear data is not served (fail closed).
# Phone-friendly cookie after first correct entry; HTTP Basic also works.
PH_VIEW_PASSWORD=

# Optional. Defaults to the Healthi "Ops cadence" project.
LINEAR_PROJECT_NAME=Ops cadence
LINEAR_PROJECT_ID=91532ea3-24e8-4e10-981e-03b6fb245cd6
LINEAR_TEAM_ID=

# Optional. Defaults to Clinic Development - Todd + Supervision Standard Rollout.
LINEAR_PLEASANT_HILL_PROJECT=Clinic Development - Todd
LINEAR_PLEASANT_HILL_PROJECTS=Clinic Development - Todd,Supervision Standard Rollout
LINEAR_TEAM_KEY=HEA


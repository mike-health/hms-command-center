# Linear personal or workspace API key (Settings → API).
# Used only on the server; never expose to the browser.
LINEAR_API_KEY=

# Optional. Defaults to the Healthi "Ops cadence" project.
LINEAR_PROJECT_NAME=Ops cadence
LINEAR_PROJECT_ID=91532ea3-24e8-4e10-981e-03b6fb245cd6

# Optional. Defaults to Healthai team (HEA).
LINEAR_TEAM_ID=09dda024-9314-4019-9c18-5185757e3edd

# Visitor fingerprint log (server only; never commit real values).
# Without VISIT_HMAC_SECRET and VISIT_INGEST_URL, POST /api/visit-log returns 204 and stores nothing.
VISIT_HMAC_SECRET=
VISIT_INGEST_URL=
VISIT_INGEST_AUTH=
